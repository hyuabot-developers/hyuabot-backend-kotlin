scalar Date
scalar DateTime
scalar LocalTime

type Query {
    notices(input: NoticeInput): [NoticeCategory!]!
    calendar(input: AcademicCalendarInput): AcademicCalendar!
    phonebook(input: PhonebookInput): Phonebook!
    readingRoom: [ReadingRoom!]!
    commute: [CommuteShuttleRoute!]!
    building(input: BuildingInput): [Building!]!
    cafeteria(input: CafeteriaInput!): [Cafeteria!]!
    bus(input: BusInput!): [BusRouteStop!]!
    subway(input: SubwayInput!): [SubwayStation!]!
}

# 공지사항 카테고리와 공지사항을 반환하는 쿼리입니다.
input NoticeInput {
    category: String
    language: String
    timestamp: DateTime
}

type NoticeCategory {
    seq: Int!
    name: String!
    notices: [Notice!]!
}

type Notice {
    seq: Int!
    title: String!
    url: String!
    userID: String!
    language: String!
    expiredAt: DateTime!
}

# 학사일정 버전, 학사일정 카테고리 및 학사일정을 반환하는 쿼리입니다.
input AcademicCalendarInput {
    category: String
    start: Date
    end: Date
}

type AcademicCalendar {
    version: String!
    categories: [AcademicCalendarCategory!]!
}

type AcademicCalendarCategory {
    seq: Int!
    name: String!
    events: [AcademicCalendarEvent!]!
}

type AcademicCalendarEvent {
    seq: Int!
    title: String!
    description: String!
    start: Date!
    end: Date!
}

# 전화부 버전, 전화부 카테고리 및 전화부 항목을 반환하는 쿼리입니다.
input PhonebookInput {
    category: String
    campus: Int
    name: String
    phone: String
}

type Phonebook {
    version: String!
    categories: [PhonebookCategory!]!
}

type PhonebookCategory {
    seq: Int!
    name: String!
    entries: [PhonebookEntry!]!
}

type PhonebookEntry {
    seq: Int!
    name: String!
    phone: String!
}

# 열람실 정보와 열람실 좌석 정보를 반환하는 쿼리입니다.
type ReadingRoom {
    seq: Int!
    name: String!
    campus: Int!
    active: Boolean!
    reservable: Boolean!
    seats: ReadingRoomSeat!
    updatedAt: DateTime!
}

type ReadingRoomSeat {
    total: Int!
    available: Int!
    active: Int!
    occupied: Int!
}

# 통학버스 노선 및 시간표를 반환하는 쿼리입니다.
type CommuteShuttleRoute {
    name: String!
    description: CommuteShuttleDescription!
    timetable: [CommuteShuttleTimetable!]!
}

type CommuteShuttleDescription {
    korean: String!
    english: String!
}

type CommuteShuttleTimetable {
    name: String!
    order: Int!
    stop: CommuteShuttleStop
    time: LocalTime!
}

type CommuteShuttleStop {
    name: String!
    latitude: Float!
    longitude: Float!
    description: String!
}

# 건물 및 강의실 정보를 반환하는 쿼리입니다.
input BuildingInput {
    name: String
    north: Float
    south: Float
    east: Float
    west: Float
}

type Building {
    seq: String
    name: String!
    latitude: Float!
    longitude: Float!
    url: String
    rooms: [Room!]!
}

type Room {
    seq: Int!
    name: String!
    number: String!
}

# 학식 식당 및 메뉴 정보를 반환하는 쿼리입니다.
input CafeteriaInput {
    date: Date
    campus: Int
}

type Cafeteria {
    seq: Int!
    name: String!
    campus: Int!
    latitude: Float!
    longitude: Float!
    runningTime: CafeteriaRunningTime!
    menus: [Menu!]!
}

type CafeteriaRunningTime {
    breakfast: String
    lunch: String
    dinner: String
}

type Menu {
    seq: Int!
    type: String!
    food: String!
    price: String!
}

# 노선 버스 정보를 반환하는 쿼리입니다.
input BusInput {
    keys: [BusRouteStopInput!]
}

input BusRouteStopInput {
    route: Int!
    order: Int!
    dates: [Date!]!
    weekdays: [String!]
}

type BusRouteStop {
    route: BusRoute!
    stop: BusStop!
    order: Int!
    startStop: BusStop!
    minutes: Int!
    realtime: [BusRealtime!]!
    timetable: [BusTimetable!]!
    log: [BusDepartureLog!]!
}

type BusRoute {
    seq: Int!
    name: String!
    type: BusRouteType!
    company: BusCompany!
    runningTime: BusRunningTime!
}

type BusRouteType {
    code: String!
    name: String!
}

type BusCompany {
    seq: Int!
    name: String!
    telephone: String!
}

type BusRunningTime {
    up: BusRunningTimeEntry!
    down: BusRunningTimeEntry!
}

type BusRunningTimeEntry {
    first: LocalTime!
    last: LocalTime!
}

type BusStop {
    seq: Int!
    name: String!
    districtCode: Int!
    region: String!
    mobileNumber: String!
    latitude: Float!
    longitude: Float!
}

type BusRealtime {
    order: Int!
    stops: Int!
    seats: Int!
    minutes: Int!
    lowFloor: Boolean!
    updatedAt: DateTime!
}

type BusTimetable {
    seq: Int!
    time: LocalTime!
    weekday: String!
}

type BusDepartureLog {
    seq: Int!
    date: Date!
    time: LocalTime!
    vehicle: String!
}

# 전철 정보를 반환하는 쿼리입니다.
input SubwayInput {
    keys: [SubwayStationInput!]!
}

input SubwayStationInput {
    stationID: String!
    direction: [String!]!
    weekdays: [String!]!
}

type SubwayStation {
    stationID: String!
    name: String!
    order: Int!
    minutes: Int!
    route: SubwayRoute!
    realtime: [SubwayRealtime!]!
    timetable: [SubwayTimetable!]!
}

type SubwayRoute {
    seq: Int!
    name: String!
}

type SubwayRealtime {
    order: Int!
    location: String!
    stops: Int!
    minutes: Int!
    direction: String!
    terminal: SubwayStation!
    trainNumber: String!
    isExpress: Boolean!
    isLast: Boolean!
    status: Int!
    updatedAt: DateTime!
}

type SubwayTimetable {
    seq: Int!
    time: LocalTime!
    weekday: String!
    direction: String!
    origin: SubwayStation!
    terminal: SubwayStation!
}
